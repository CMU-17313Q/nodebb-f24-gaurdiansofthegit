{
  "node": true,
  "esversion": 11,
  "asi": true,
  "strict": false,
  "expr": true,
  "shadow": true,
  "globals": {
    "$": true,
    "define": true,
    "alert": true,
    "escape": true,
    "bootbox": true,
    "ajaxify": true,
    "app": true,
    "window": true,
    "document": true,
    "config": true,
    "socket": true,
    "utils": true,
    "FormData": true,
    "fetch": true,
    "AbortSignal": true,
    "navigator": true,
    "Blob": true,
    "self": true,
    "location": true,
    "overrides": true,
    "caches": true,
    "jQuery": true,
    "describe": true,
    "it": true,
    "before": true,
    "after": true,
    "beforeEach": true,
    "afterEach": true,
    "setTimeout": true
  },
  "loopfunc": true,
  "eqnull": true,
  "latedef": "nofunc",
  "browser": true,
  "sub": true,
  "nocomma": true,
  "proto": true,
  "unused": false,
  "funcscope": true,
  "-W018": false
}
